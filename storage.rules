rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The app uses bundled illustrations, not uploaded media. Keep Storage closed
    // until a trusted upload service enforces quotas and validates actual bytes.
    // Existing download tokens must be revoked separately; rules do not revoke URLs.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
